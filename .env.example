
CACHING_ON=false

PORT=8080
GUNICORN_WORKERS=2

LAJI_API_ACCESS_TOKEN=replace_with_your_token
SECRET_KEY=replace_with_a_random_secret
FLUSH_SECRET_KEY=replace_with_a_secret

# Use double quotes: semicolons confuse strict dotenv parsers (e.g. uv run --env-file).
HIDDEN_NAMES="Matti Meikäläinen;Smith, John"
